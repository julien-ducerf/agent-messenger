[Unit]
Description=Compact the Agent Messenger WAL

[Service]
Type=oneshot
User=agent-messenger
Group=agent-messenger
WorkingDirectory=/opt/agent-messenger
Environment=AGENT_MESSENGER_CONFIG=/etc/agent-messenger/config.toml
ExecStart=/opt/agent-messenger/.venv/bin/python -m agent_messenger.maintenance checkpoint
StateDirectory=agent-messenger
StateDirectoryMode=0700
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
CapabilityBoundingSet=
ReadWritePaths=/var/lib/agent-messenger
LimitCORE=0
